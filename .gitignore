# Veri: Git'e girmez (boyut + Kaggle lisansı)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# İstisna: bölme indeksleri commit'lenir (sızıntı disiplininin tarihli kanıtı, D03)
!data/processed/bolme/
!data/processed/bolme/**

# Python sanal ortamı ve önbellekler
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Gizli bilgiler
.env

# Yerel yardimci betik (Claude her adimda gunceller)
commit_bekleyen.cmd
